# 本地开发环境配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ================================
# Redis 连接配置
# ================================
# 本地开发：连接 Docker 容器中的 Redis（端口 8911）
# Docker 部署：使用 docker-compose.yml 中的配置
CELERY_BROKER_URL=redis://127.0.0.1:8911/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:8911/0

# ================================
# Django 基础配置
# ================================
# 调试模式（生产环境请设为 False）
DJANGO_DEBUG=True

# Django 密钥（生产环境必须修改为随机字符串）
DJANGO_SECRET_KEY=dev-secret-key-change-in-production

# 允许访问的主机（生产环境请设置具体域名）
DJANGO_ALLOWED_HOSTS=*

# CORS 跨域允许的源（根据前端地址配置）
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:80,http://localhost:8913,http://127.0.0.1:8913

# CSRF 信任来源（可选，逗号分隔，跨域或通过反向代理访问时使用）
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:80,http://localhost:8913

# HTTP 请求用户代理标识，用于 LangChain/LangGraph 等外部请求识别来源
USER_AGENT=WHartTest/2.6.0-pe

# API 基础 URL（可选，用于内部 API 调用）
# DJANGO_BASE_URL=http://localhost:8000

# ================================
# 数据库配置
# ================================
# 数据库类型: postgres（默认，生产推荐） 或 sqlite（本地开发）
DATABASE_TYPE=postgres
# 可选：按环境/分支自动切换数据库。支持：ce、pe、dev、auto（默认 auto）
POSTGRES_DB_VARIANT=auto

# PostgreSQL 配置（DATABASE_TYPE=postgres 时使用）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=8919
POSTGRES_DB=wharttest
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# SQLite 数据库路径（DATABASE_TYPE=sqlite 时使用）
# DATABASE_PATH=./db.sqlite3

# ================================
# 媒体与数据文件存储路径
# ================================
# 本地开发时指向项目根目录下的 data/media，与 Docker 部署保持一致
# Docker 部署时通过 docker-compose.yml 设置为 /app/data/media
MEDIA_ROOT=../data/media
DATA_DIR=../data

# ================================
# 授权控制（License）配置
# ================================
# LICENSE_MODE: client（受控校验，默认）/ off（仅开发环境）
# LICENSE_MODE=off
# 授权中心地址（心跳上报/领证目标）
# LICENSE_SERVER_URL=http://license-server.example.com
# LICENSE_HEARTBEAT_INTERVAL_SECONDS=86400
# LICENSE_HEARTBEAT_TIMEOUT_SECONDS=30

# ================================
# 文件管理配置
# ================================
# 单文件上传大小限制，单位：字节，默认 100MB
FILE_MANAGEMENT_MAX_FILE_SIZE=104857600
# LLM 对话单次绑定附件数量上限，默认 50
FILE_MANAGEMENT_MAX_BIND_COUNT=50
# LLM 附件单文件解析文本字符数限制；0 表示不限制，超限会报错且不会截断
FILE_MANAGEMENT_LLM_MAX_CHARS_PER_FILE=0

# ================================
# 微信官方插件宿主配置
# ================================
# 后端访问 weixin-plugin-host 的地址
# - Docker 全量部署：无需设置，docker-compose.yml 已通过内部网络配置 (http://weixin-plugin-host:3001)
# - 本地开发（后端本地 + weixin-plugin-host Docker 容器）：使用容器映射到宿主机的端口 8922 或本地 3001
WEIXIN_PLUGIN_HOST_URL=http://127.0.0.1:3001

# ================================
# DOCX Editor 集成配置（主项目后端 -> docx-editor）
# ================================
# `DOCX_EDITOR_BASE_URL` 填主项目后端服务端实际访问 docx-editor 的地址：
# - 主项目源码部署在宿主机：通常使用 `http://127.0.0.1:8910`
# - 主项目跑在容器里：通常使用 `http://host.docker.internal:8910`
DOCX_EDITOR_BASE_URL=http://127.0.0.1:8910
# 可选：覆盖 docx-editor 返回给浏览器的外部地址。必须填写浏览器真实可访问的地址：
# - 浏览器通过本机端口转发访问：`http://127.0.0.1:8910`
# - 浏览器可直连宿主机/域名：填实际可访问地址
DOCX_EDITOR_PUBLIC_BASE_URL=http://127.0.0.1:8910
# 必须与 docx-editor/.env 中的 DOCX_EDITOR_SERVICE_KEY 完全一致
DOCX_EDITOR_SERVICE_KEY=docx-editor-default-integration-key-2026

# ================================
# ONLYOFFICE Document Server 配置
# ================================
# 浏览器访问 ONLYOFFICE 的地址。本地/反向代理部署时应使用同域路径，避免浏览器直连容器端口
ONLYOFFICE_DOCUMENT_SERVER_URL=/onlyoffice
ONLYOFFICE_JWT_SECRET=your-onlyoffice-jwt-secret
# Document Server 容器回调/拉取文件使用的内部地址。Docker Compose 下应保持为 backend:8000
ONLYOFFICE_BACKEND_INTERNAL_BASE_URL=http://backend:8000
ONLYOFFICE_INTERNAL_BASE_URL=http://onlyoffice
# ONLYOFFICE 文件访问 Token 有效期（秒，默认 3600）
ONLYOFFICE_FILE_TOKEN_TTL_SECONDS=3600

# ================================
# 技能商店（Skill Store）配置（可选）
# ================================
# 默认商店源 ZIP 包下载 URL 或 GitHub release 地址
# SKILL_STORE_DEFAULT_SOURCE=
# SKILL_STORE_DEFAULT_SOURCE_NAME=官方技能库
# SKILL_STORE_ALLOW_CUSTOM_SOURCE=True
# SKILL_STORE_MAX_ZIP_SIZE=10485760
# SKILL_STORE_DOWNLOAD_TIMEOUT=60

# ================================
# Qdrant 向量数据库配置
# ================================
# 本地开发：连接 Docker 容器中的 Qdrant（端口 8918）
# Docker 部署：使用 docker-compose.yml 中的配置（http://qdrant:6333）
QDRANT_URL=http://127.0.0.1:8918

# ================================
# Django 管理员账户（首次启动时创建）
# ================================
# DJANGO_ADMIN_USERNAME=admin
# DJANGO_ADMIN_EMAIL=admin@example.com
# DJANGO_ADMIN_PASSWORD=admin123456

# ================================
# 录制器画面参数（可选）
# ================================
# 录制画布 JPEG 质量（1-100），越高越清晰、数据量越大。默认 50
RECORDER_JPEG_QUALITY=70
# 录制画布目标帧率（1-60），默认 25。带宽紧张可降到 20/15
RECORDER_FRAME_RATE=20
# 推流分辨率缩放（0.1-1），默认 1=原生分辨率。仅带宽不足时才降低
RECORDER_FRAME_SCALE=1
# 冻结页面动画（默认开启）。动画页（如登录页 WebGL 渐变背景、轮播）会使推流
# 持续全帧编码、画布操作迟缓；冻结后画面趋于静态，帧流负载趋近于零。仅支持
# 设为 false 关闭（如需观察动画本身的表现），其他取值均视为开启
RECORDER_FREEZE_ANIMATION=true
