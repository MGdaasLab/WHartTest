# WHartTest MCP 服务配置

# WHartTest Tools - 后端 API 地址
# Docker 环境使用: http://backend:8000
# 本地开发使用: http://localhost:8000
WHARTTEST_BACKEND_URL=http://localhost:8000

# WHartTest Tools - API Key
# 默认使用系统自动生成的固定密钥，开箱即用
# 
# ⚠️ 安全提示：
# - 源码中公开过的固定演示密钥已废除，请配置自己的密钥
# 创建新密钥：登录后台 -> 系统管理 -> API密钥（或 init_admin 自动生成的随机 Key）
WHARTTEST_API_KEY=

# MS MCP API - 测试平台集成配置（可选）
# 如需使用 MS 测试平台集成，请取消注释并填写正确的密钥
# 注意：MS_SECRET_KEY 必须是 16、24 或 32 字节长度
# MS_API_HOST=http://ms.example.com
# MS_ACCESS_KEY=your_16byte_key1
# MS_SECRET_KEY=your_16byte_key2